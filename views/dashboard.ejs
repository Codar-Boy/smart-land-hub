<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Service Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="dashboard-layout">
    <% const section=locals.activeSection || 'overview' ; %>
        <aside class="sidebar">
            <div class="sidebar-header">
                <h3>
                    <%= config.business_name || 'RMS v1.0' %>
                </h3>
            </div>
            <nav class="sidebar-nav">
                <a href="/dashboard/overview" class="<%= section === 'overview' ? 'active' : '' %>"><i
                        class="fas fa-chart-line"></i> Overview</a>
                <a href="/dashboard/services" class="<%= section === 'services' ? 'active' : '' %>"><i
                        class="fas fa-file-invoice"></i> Services</a>
                <a href="/dashboard/due-tracking" class="<%= section === 'due-tracking' ? 'active' : '' %>"><i
                        class="fas fa-hand-holding-dollar"></i> Due Tracking</a>
                <a href="/dashboard/expenses" class="<%= section === 'expenses' ? 'active' : '' %>"><i
                        class="fas fa-wallet"></i> Expenses</a>
                <a href="/dashboard/day-book" class="<%= section === 'day-book' ? 'active' : '' %>"><i
                        class="fas fa-book"></i> Day Book</a>
                <a href="/dashboard/reports" class="<%= section === 'reports' ? 'active' : '' %>"><i
                        class="fas fa-file-contract"></i> Reports</a>
                <a href="/dashboard/profit-loss" class="<%= section === 'profit-loss' ? 'active' : '' %>"><i
                        class="fas fa-money-bill-trend-up"></i> P&L Report</a>
                <a href="/dashboard/balance-sheet" class="<%= section === 'balance-sheet' ? 'active' : '' %>"><i
                        class="fas fa-scale-balanced"></i> Balance Sheet</a>
                <a href="/dashboard/settings" class="<%= section === 'settings' ? 'active' : '' %>"><i
                        class="fas fa-gears"></i> Settings</a>
                <div class="sidebar-footer">
                    <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
                </div>
            </nav>
        </aside>

        <div class="content-wrapper">
            <header class="main-header">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <button class="hamburger" onclick="toggleSidebar()">☰</button>
                    <h1>
                        <%= section.toUpperCase().replace('-', ' ' ) %>
                    </h1>
                </div>
                <div class="user-meta">
                    <i class="fas fa-user-shield"></i>
                    <%= locals.username %> | <i class="fas fa-calendar-day"></i>
                        <%= new Date().toLocaleDateString() %>
                </div>
            </header>

            <%# ─── Flash Message ──────────────────────────────── %>
            <% if (locals.flash) { %>
              <div style="margin: 10px 20px; padding: 12px 18px; border-radius: 6px;
                          background: <%= flash.type === 'success' ? '#d4edda' : '#f8d7da' %>;
                          color: <%= flash.type === 'success' ? '#155724' : '#721c24' %>;
                          border: 1px solid <%= flash.type === 'success' ? '#c3e6cb' : '#f5c6cb' %>;
                          font-weight: 600;">
                <%= flash.type === 'success' ? '✅' : '⚠️' %> <%= flash.message %>
              </div>
            <% } %>

            <main>
                <% if (section==='overview' ) { %>
                    <h2><i class="fas fa-chart-line"></i> Dashboard Overview</h2>
                    <% if (locals.stats) { %>
                        <!-- Stat Cards -->
                        <div style="display: flex; gap: 15px; margin: 20px 0;">
                            <div style="flex: 1; border: 1px solid #ddd; padding: 20px; text-align: center;">
                                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #999;">Today's Income</div>
                                <div style="font-size: 1.8rem; font-weight: bold; margin-top: 5px;">₹<%= (stats.todayTotalServices || 0).toFixed(2) %></div>
                                <div style="font-size: 0.8rem; color: #888;"><%= stats.todaySalesCount || 0 %> service(s)</div>
                            </div>
                            <div style="flex: 1; border: 1px solid #ddd; padding: 20px; text-align: center;">
                                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #999;">Today's Expenses</div>
                                <div style="font-size: 1.8rem; font-weight: bold; margin-top: 5px; color: red;">₹<%= (stats.todayExpenses || 0).toFixed(2) %></div>
                                <div style="font-size: 0.8rem; color: #888;"><%= stats.todayExpensesCount || 0 %> expense(s)</div>
                            </div>
                            <div style="flex: 1; border: 1px solid #ddd; padding: 20px; text-align: center;">
                                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #999;">Total Pending Dues</div>
                                <div style="font-size: 1.8rem; font-weight: bold; margin-top: 5px;">₹<%= (stats.totalPendingDues || 0).toFixed(2) %></div>
                                <a href="/dashboard/due-tracking" style="font-size: 0.8rem;">View All →</a>
                            </div>
                            <div style="flex: 1; border: 1px solid #ddd; padding: 20px; text-align: center;">
                                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: #999;">This Month Expenses</div>
                                <div style="font-size: 1.8rem; font-weight: bold; margin-top: 5px;">₹<%= (stats.monthExpenses || 0).toFixed(2) %></div>
                                <a href="/dashboard/reports" style="font-size: 0.8rem;">Full Report →</a>
                            </div>
                        </div>

                        <!-- Two Column: Breakdown + Top Debtors -->
                        <div style="display: flex; gap: 20px; margin-top: 20px;">
                            <div style="flex: 1;">
                                <h3><i class="fas fa-chart-pie"></i> Service Breakdown (Top 5)</h3>
                                <table border="1">
                                    <tr><th>Service Type</th><th>Count</th></tr>
                                    <% if (stats.serviceBreakdown && stats.serviceBreakdown.length > 0) { %>
                                        <% stats.serviceBreakdown.forEach(function(item) { %>
                                            <tr><td><%= item.service_type %></td><td><%= item.count %></td></tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="2" style="text-align: center; color: #999;">No data yet</td></tr>
                                    <% } %>
                                </table>
                            </div>
                            <div style="flex: 1;">
                                <h3><i class="fas fa-exclamation-triangle"></i> Top Debtors</h3>
                                <table border="1">
                                    <tr><th>Customer</th><th>Due Amount</th></tr>
                                    <% if (stats.topDues && stats.topDues.length > 0) { %>
                                        <% stats.topDues.forEach(function(d) { %>
                                            <tr><td><%= d.customer_name %></td><td style="color: red; font-weight: bold;">₹<%= d.due_amount %></td></tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="2" style="text-align: center; color: green;">No pending dues! 🎉</td></tr>
                                    <% } %>
                                </table>
                            </div>
                        </div>

                        <br>
                        <h3><i class="fas fa-clock"></i> Recent Services</h3>
                        <table border="1">
                            <thead>
                                <tr><th>Date</th><th>Customer</th><th>Service</th><th>Total</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                <% if (stats.recentServices && stats.recentServices.length > 0) { %>
                                    <% stats.recentServices.forEach(function(s) { %>
                                        <tr>
                                            <td><%= new Date(s.date).toLocaleDateString() %></td>
                                            <td><%= s.customer_name %></td>
                                            <td><%= s.service_type %></td>
                                            <td>₹<%= s.total_amount %></td>
                                            <td><%= s.due_amount > 0 ? '⏳ Due' : '✅ Paid' %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="5" style="text-align: center;">No recent data</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    <% } %>
                <% } %>

                                <% if (section==='services' ) { %>
                                    <h2>Service Management</h2>
                                    <button
                                        onclick="document.getElementById('addForm').style.display = (document.getElementById('addForm').style.display === 'none' ? 'block' : 'none')">➕
                                        Add New Service Record</button>
                                    <div id="addForm" class="compact-form" style="display: none;">
                                        <h3>Register New Service</h3>
                                        <form class="compact-form-grid" action="/services/add" method="POST">
                                            <div>
                                                <label for="add-date">Date</label>
                                                <input type="date" id="add-date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required>
                                            </div>
                                            <div>
                                                <label for="add-customer">Customer</label>
                                                <input type="text" id="add-customer" name="customer_name" required onblur="fillCustomerDetails()">
                                            </div>
                                            <div>
                                                <label for="add-mobile">Mobile</label>
                                                <input type="text" id="add-mobile" name="mobile_no" placeholder="Optional" onblur="fillCustomerDetails()">
                                            </div>
                                            <div>
                                                <label for="add-service-type">Type</label>
                                                <select id="add-service-type" name="service_type" required>
                                                    <% if (locals.serviceTypes) { %>
                                                        <% serviceTypes.forEach(function(t) { %>
                                                            <option><%= t.name %></option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <div>
                                                <label for="qty">Qty</label>
                                                <input type="number" name="quantity" id="qty" value="1" min="1" step="1" required oninput="updateAddTotals()">
                                            </div>
                                            <div>
                                                <label for="rate">Rate</label>
                                                <input type="number" name="rate" id="rate" value="0" min="0" step="0.01" required oninput="updateAddTotals()">
                                            </div>
                                            <div>
                                                <label for="discount">Discount</label>
                                                <input type="number" name="discount" id="discount" value="0" min="0" step="0.01" oninput="updateAddTotals()">
                                            </div>
                                            <div>
                                                <label for="t">Total</label>
                                                <input type="number" name="total_amount" id="t" readonly value="0.00">
                                            </div>
                                            <div>
                                                <label for="r">Received</label>
                                                <input type="number" name="received_amount" id="r" value="0.00" step="0.01" required oninput="updateAddTotals()">
                                            </div>
                                            <div>
                                                <label for="d">Due</label>
                                                <input type="number" name="due_amount" id="d" readonly value="0.00">
                                            </div>
                                            <div class="full-width">
                                                <label for="add-notes">Notes</label>
                                                <textarea id="add-notes" name="notes" placeholder="Optional notes" rows="2"></textarea>
                                            </div>
                                            <div class="form-actions full-width">
                                                <button type="submit">Save Record</button>
                                                <button type="button" onclick="document.getElementById('addForm').style.display='none'">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                    <% if (locals.editService) { %>
                                    <div class="edit-form">
                                        <h3>Edit Service Record</h3>
                                        <form action="/services/edit/<%= editService.id %>" method="POST">
                                            <div>
                                                <label for="edit-date">Date</label>
                                                <input type="date" id="edit-date" name="date" required value="<%= editService.date ? new Date(editService.date).toISOString().split('T')[0] : '' %>">
                                            </div>
                                            <div>
                                                <label for="edit-customer">Customer</label>
                                                <input type="text" id="edit-customer" name="customer_name" required value="<%= editService.customer_name %>">
                                            </div>
                                            <div>
                                                <label for="edit-mobile">Mobile</label>
                                                <input type="text" id="edit-mobile" name="mobile_no" value="<%= editService.mobile_no %>">
                                            </div>
                                            <div>
                                                <label for="edit-type">Type</label>
                                                <select id="edit-type" name="service_type">
                                                    <% serviceTypes.forEach(t => { %>
                                                        <option <%= editService.service_type === t.name ? 'selected' : '' %>><%= t.name %></option>
                                                    <% }) %>
                                                    <option <%= !serviceTypes.some(t => t.name === editService.service_type) ? 'selected' : '' %>>Others</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label for="edit-quantity">Qty</label>
                                                <input type="number" id="edit-quantity" name="quantity" min="1" step="1" value="<%= editService.quantity || 1 %>" required oninput="updateEditTotals()">
                                            </div>
                                            <div>
                                                <label for="edit-rate">Rate</label>
                                                <input type="number" id="edit-rate" name="rate" step="0.01" min="0" value="<%= editService.rate || 0 %>" required oninput="updateEditTotals()">
                                            </div>
                                            <div>
                                                <label for="edit-discount">Discount</label>
                                                <input type="number" id="edit-discount" name="discount" step="0.01" min="0" value="<%= editService.discount || 0 %>" oninput="updateEditTotals()">
                                            </div>
                                            <div>
                                                <label for="edit-total">Total</label>
                                                <input type="number" id="edit-total" name="total_amount" step="0.01" value="<%= editService.total_amount %>" readonly>
                                            </div>
                                            <div>
                                                <label for="edit-received">Received</label>
                                                <input type="number" id="edit-received" name="received_amount" step="0.01" value="<%= editService.received_amount %>" oninput="updateEditTotals()">
                                            </div>
                                            <div>
                                                <label for="edit-due">Due</label>
                                                <input type="number" id="edit-due" name="due_amount" readonly value="<%= editService.due_amount %>">
                                            </div>
                                            <div>
                                                <label for="edit-payment">Payment Mode</label>
                                                <select id="edit-payment" name="payment_mode">
                                                    <% ['Cash', 'UPI', 'Due'].forEach(opt => { %>
                                                        <option <%= editService.payment_mode === opt ? 'selected' : '' %>><%= opt %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="grid-column: span 2;">
                                                <label for="edit-notes">Notes</label>
                                                <textarea id="edit-notes" name="notes" rows="3"><%= editService.notes || '' %></textarea>
                                            </div>
                                            <button type="submit">Update Record</button>
                                            <a href="/dashboard/services"><button type="button">Cancel</button></a>
                                        </form>
                                    </div>
                                    <% } %>
                                    <br>
                                    <!-- Search Filter -->
                                    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 15px;">
                                        <i class="fas fa-search"></i>
                                        <input type="text" id="serviceSearch" placeholder="Search by customer, mobile, or service..." oninput="filterTable()" style="flex: 1; padding: 8px; border: 1px solid #ddd;">
                                        <button onclick="exportCSV()" style="padding: 8px 15px; border: 1px solid #000; background: #000; color: #fff; cursor: pointer;"><i class="fas fa-download"></i> Export CSV</button>
                                    </div>
                                    <div class="table-container">
                                    <table border="1" id="servicesTable">
                                        <thead>
                                            <tr><th>Date</th><th>Customer</th><th>Mobile</th><th>Service</th><th>Total</th><th>Due</th><th>Actions</th></tr>
                                        </thead>
                                        <tbody>
                                        <% if (locals.services) { %>
                                            <% services.forEach(function(s) { %>
                                                <tr>
                                                    <td><%= new Date(s.date).toLocaleDateString() %></td>
                                                    <td><%= s.customer_name %></td>
                                                    <td><%= s.mobile_no || '-' %></td>
                                                    <td><%= s.service_type %></td>
                                                    <td>₹<%= s.total_amount %></td>
                                                    <td><%= parseFloat(s.due_amount) > 0 ? '₹' + s.due_amount : '✅ Paid' %></td>
                                                    <td>
                                                        <a href="/services/edit/<%= s.id %>" title="Edit"><i class="fas fa-edit"></i></a>
                                                        <a href="/services/print/<%= s.id %>" target="_blank" title="Print"><i class="fas fa-print"></i></a>
                                                        <% if (s.mobile_no) { %>
                                                            <a href="https://wa.me/91<%= s.mobile_no %>?text=Hi%20<%= encodeURIComponent(s.customer_name) %>,%20your%20invoice%20%23<%= s.id %>%20of%20₹<%= s.total_amount %>%20(Due:%20₹<%= s.due_amount %>)%20from%20<%= encodeURIComponent(config.business_name || 'our business') %>.%20Thank%20you!" target="_blank" title="WhatsApp" style="color: green;"><i class="fab fa-whatsapp"></i></a>
                                                        <% } %>
                                                        <form method="POST" action="/services/delete/<%= s.id %>" style="display:inline;">
                                                          <button type="submit" onclick="return confirm('Delete this record? This cannot be undone.')" title="Delete" style="background:none;border:none;cursor:pointer;color:red;padding:0;font-size:inherit;"><i class="fas fa-trash"></i></button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } %>
                                        </tbody>
                                    </table>
                                    </div>
                                    <script>
                                        function filterTable() {
                                            const q = document.getElementById('serviceSearch').value.toLowerCase();
                                            document.querySelectorAll('#servicesTable tbody tr').forEach(row => {
                                                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
                                            });
                                        }
                                        const servicesData = <%- JSON.stringify(services || []) %>;
                                        const customerLookup = {};
                                        const mobileLookup = {};
                                        servicesData.forEach(function(s) {
                                            if (s.customer_name) {
                                                customerLookup[s.customer_name.trim().toLowerCase()] = {
                                                    mobile: s.mobile_no || '',
                                                    service_type: s.service_type || ''
                                                };
                                            }
                                            if (s.mobile_no) {
                                                mobileLookup[s.mobile_no.trim()] = {
                                                    customer_name: s.customer_name || '',
                                                    service_type: s.service_type || ''
                                                };
                                            }
                                        });
                                        function fillCustomerDetails() {
                                            const customerInput = document.getElementById('add-customer');
                                            const mobileInput = document.getElementById('add-mobile');
                                            const name = customerInput.value.trim();
                                            const mobile = mobileInput.value.trim();

                                            const typeSelect = document.querySelector('select[name="service_type"]');
                                            if (name && customerLookup[name.toLowerCase()]) {
                                                const match = customerLookup[name.toLowerCase()];
                                                if (!mobile && match.mobile) {
                                                    mobileInput.value = match.mobile;
                                                }
                                                if (typeSelect && match.service_type) {
                                                    Array.from(typeSelect.options).forEach(opt => {
                                                        if (opt.value === match.service_type) {
                                                            opt.selected = true;
                                                        }
                                                    });
                                                }
                                            }
                                            if (mobile && mobileLookup[mobile]) {
                                                const match = mobileLookup[mobile];
                                                if (!name && match.customer_name) {
                                                    customerInput.value = match.customer_name;
                                                }
                                                if (typeSelect && match.service_type) {
                                                    Array.from(typeSelect.options).forEach(opt => {
                                                        if (opt.value === match.service_type) {
                                                            opt.selected = true;
                                                        }
                                                    });
                                                }
                                            }
                                        }
                                        function updateAddTotals() {
                                            const qty = parseFloat(document.getElementById('qty').value) || 1;
                                            const rate = parseFloat(document.getElementById('rate').value) || 0;
                                            const discount = parseFloat(document.getElementById('discount').value) || 0;
                                            const received = parseFloat(document.getElementById('r').value) || 0;
                                            const total = Math.max(0, qty * rate - discount);
                                            document.getElementById('t').value = total.toFixed(2);
                                            document.getElementById('d').value = Math.max(0, total - received).toFixed(2);
                                        }
                                        function updateEditTotals() {
                                            const qty = parseFloat(document.getElementById('edit-quantity').value) || 1;
                                            const rate = parseFloat(document.getElementById('edit-rate').value) || 0;
                                            const discount = parseFloat(document.getElementById('edit-discount').value) || 0;
                                            const received = parseFloat(document.getElementById('edit-received').value) || 0;
                                            const total = Math.max(0, qty * rate - discount);
                                            document.getElementById('edit-total').value = total.toFixed(2);
                                            document.getElementById('edit-due').value = Math.max(0, total - received).toFixed(2);
                                        }
                                        document.addEventListener('DOMContentLoaded', function() {
                                            if (document.getElementById('edit-quantity')) {
                                                updateEditTotals();
                                            }
                                            if (document.getElementById('qty')) {
                                                updateAddTotals();
                                            }
                                        });
                                        function exportCSV() {
                                            const rows = document.querySelectorAll('#servicesTable tr');
                                            let csv = '';
                                            rows.forEach(row => {
                                                const cols = row.querySelectorAll('th, td');
                                                const line = Array.from(cols).slice(0, -1).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"').join(',');
                                                csv += line + '\n';
                                            });
                                            const blob = new Blob([csv], { type: 'text/csv' });
                                            const a = document.createElement('a');
                                            a.href = URL.createObjectURL(blob);
                                            a.download = 'services_export.csv';
                                            a.click();
                                        }
                                    </script>
                                    <% } %>

                                        <% if (section==='due-tracking' ) { %>
                                            <h2>Due Tracking (Unpaid Records)</h2>
                                            <div class="table-container">
                                            <table border="1">
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Customer</th>
                                                    <th>Service</th>
                                                    <th>Total</th>
                                                    <th>Remaining Due</th>
                                                    <th>Quick Pay</th>
                                                </tr>
                                                <% if (locals.dueRecords && dueRecords.length> 0) { %>
                                                    <% dueRecords.forEach(function(r) { %>
                                                        <tr>
                                                            <td>
                                                                <%= new Date(r.date).toLocaleDateString() %>
                                                            </td>
                                                            <td>
                                                                <%= r.customer_name %>
                                                            </td>
                                                            <td>
                                                                <%= r.service_type %>
                                                            </td>
                                                            <td>₹<%= r.total_amount %>
                                                            </td>
                                                            <td style="color: red; font-weight: bold;">₹<%= r.due_amount
                                                                    %>
                                                            </td>
                                                            <td>
                                                                <form action="/services/pay/<%= r.id %>" method="POST"
                                                                    style="display: inline;">
                                                                    <input type="number" name="pay_amount" step="0.01"
                                                                        placeholder="Amt" style="width: 80px;" required
                                                                        max="<%= r.due_amount %>">
                                                                    <button type="submit">Pay</button>
                                                                </form>
                                                                | <a href="/services/edit/<%= r.id %>">Full Edit</a>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="6" align="center">No pending dues
                                                                        found!</td>
                                                                </tr>
                                                                <% } %>
                                            </table>
                                            </div>
                                            <% } %>

                                                <% if (section==='expenses' ) { %>
                                                    <h2>Expenses</h2>
                                                    <div class="edit-form">
                                                        <h3>Add New Expense</h3>
                                                        <form action="/expenses/add" method="POST">
                                                            <div>
                                                                <label for="add-exp-date">Date</label>
                                                                <input type="date" id="add-exp-date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required>
                                                            </div>
                                                            <div>
                                                                <label for="add-exp-desc">Description</label>
                                                                <input type="text" id="add-exp-desc" name="description" required>
                                                            </div>
                                                            <div>
                                                                <label for="add-exp-amount">Amount</label>
                                                                <input type="number" id="add-exp-amount" name="amount" required>
                                                            </div>
                                                            <div>
                                                                <label for="add-exp-category">Category</label>
                                                                <select id="add-exp-category" name="category">
