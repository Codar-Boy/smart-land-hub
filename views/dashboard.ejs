                                                                                                                                <td><input
                                                                                                                                        type="text"
                                                                                                                                        name="upi_id"
                                                                                                                                        value="<%= config.upi_id || '' %>"
                                                                                                                                        placeholder="name@upi">
                                                                                                                                </td>
                                                                                                                            </tr>
                                                                                                                            <tr>
                                                                                                                                <td>
                                                                                                                                </td>
                                                                                                                                <td><button
                                                                                                                                        type="submit">Save
                                                                                                                                        Profile
                                                                                                                                        Changes</button>
                                                                                                                                </td>
                                                                                                                            </tr>
                                                                                                                        </table>
                                                                                                                    </form>
                                                                                                                </fieldset>

                                                                                                                <br>
                                                                                                                <fieldset>
                                                                                                                    <legend>
                                                                                                                        2.
                                                                                                                        Security
                                                                                                                        &
                                                                                                                        Access
                                                                                                                    </legend>
                                                                                                                    <form
                                                                                                                        action="/settings/password"
                                                                                                                        method="POST">
                                                                                                                        <table
                                                                                                                            border="0"
                                                                                                                            cellpadding="5">
                                                                                                                            <tr>
                                                                                                                                <td>Old
                                                                                                                                    Password:
                                                                                                                                </td>
                                                                                                                                <td><input
                                                                                                                                        type="password"
                                                                                                                                        name="current_password"
                                                                                                                                        required>
                                                                                                                                </td>
                                                                                                                            </tr>
                                                                                                                            <tr>
                                                                                                                                <td>New
                                                                                                                                    Password:
                                                                                                                                </td>
                                                                                                                                <td><input
                                                                                                                                        type="password"
                                                                                                                                        name="new_password"
                                                                                                                                        required>
                                                                                                                                </td>
                                                                                                                            </tr>
                                                                                                                            <tr>
                                                                                                                                <td>Confirm
                                                                                                                                    New:
                                                                                                                                </td>
                                                                                                                                <td><input
                                                                                                                                        type="password"
                                                                                                                                        name="confirm_password"
                                                                                                                                        required>
                                                                                                                                </td>
                                                                                                                            </tr>
                                                                                                                            <tr>
                                                                                                                                <td>
                                                                                                                                </td>
                                                                                                                                <td><button
                                                                                                                                        type="submit">Update
                                                                                                                                        Password</button>
                                                                                                                                </td>
                                                                                                                            </tr>
                                                                                                                        </table>
                                                                                                                    </form>
                                                                                                                </fieldset>

                                                                                                                <br>
                                                                                                                <fieldset>
                                                                                                                    <legend>
                                                                                                                        3. Change User ID
                                                                                                                    </legend>
                                                                                                                    <form action="/settings/username" method="POST">
                                                                                                                        <table border="0" cellpadding="5">
                                                                                                                            <tr>
                                                                                                                                <td>New User ID:</td>
                                                                                                                                <td><input type="text" name="new_username" required></td>
                                                                                                                            </tr>
                                                                                                                            <tr>
                                                                                                                                <td>Current Password:</td>
                                                                                                                                <td><input type="password" name="current_password" required></td>
                                                                                                                            </tr>
                                                                                                                            <tr>
                                                                                                                                <td></td>
                                                                                                                                <td><button type="submit">Update User ID</button></td>
                                                                                                                            </tr>
                                                                                                                        </table>
                                                                                                                    </form>
                                                                                                                </fieldset>

                                                                                                                <br>
                                                                                                                <fieldset>
                                                                                                                    <legend>
                                                                                                                        4.
                                                                                                                        Service
                                                                                                                        Category
                                                                                                                        Manager
                                                                                                                    </legend>
                                                                                                                    <form
                                                                                                                        action="/settings/service-types/add"
                                                                                                                        method="POST">
                                                                                                                        New
                                                                                                                        Category:
                                                                                                                        <input
                                                                                                                            type="text"
                                                                                                                            name="name"
                                                                                                                            required
                                                                                                                            placeholder="e.g. Agreement">
                                                                                                                        <button
                                                                                                                            type="submit">Add
                                                                                                                            Category</button>
                                                                                                                    </form>
                                                                                                                    <ul>
                                                                                                                        <% if
                                                                                                                            (locals.serviceTypes)
                                                                                                                            {
                                                                                                                            %>
                                                                                                                            <% serviceTypes.forEach(function(t)
                                                                                                                                {
                                                                                                                                %>
                                                                                                                                <li>
                                                                                                                                    <%= t.name %>
                                                                                                                                    <form method="POST" action="/settings/service-types/delete/<%= t.id %>" style="display:inline;">
                                                                                                                                      <button type="submit" onclick="return confirm('Delete this service type?')" style="background:none;border:none;cursor:pointer;color:red;padding:0;">[Delete]</button>
                                                                                                                                    </form>
                                                                                                                                </li>
                                                                                                                                <% });
                                                                                                                                    %>
                                                                                                                                    <% }
                                                                                                                                        %>
                                                                                                                    </ul>
                                                                                                                </fieldset>

                                                                                                                <br>
                                                                                                                <fieldset>
                                                                                                                    <legend>
                                                                                                                        5.
                                                                                                                        Expense
                                                                                                                        Category
                                                                                                                        Manager
                                                                                                                    </legend>
                                                                                                                    <form
                                                                                                                        action="/settings/expense-categories/add"
                                                                                                                        method="POST">
                                                                                                                        New
                                                                                                                        Category:
                                                                                                                        <input
                                                                                                                            type="text"
                                                                                                                            name="name"
                                                                                                                            required
                                                                                                                            placeholder="e.g. Stationery">
                                                                                                                        <button
                                                                                                                            type="submit">Add
                                                                                                                            Category</button>
                                                                                                                    </form>
                                                                                                                    <ul>
                                                                                                                        <% if (locals.expenseCategories) { %>
                                                                                                                            <% expenseCategories.forEach(function(c) { %>
                                                                                                                                <li>
                                                                                                                                    <%= c.name %>
                                                                                                                                    <form method="POST" action="/settings/expense-categories/delete/<%= c.id %>" style="display:inline;">
                                                                                                                                      <button type="submit" onclick="return confirm('Delete this category?')" style="background:none;border:none;cursor:pointer;color:red;padding:0;">[Delete]</button>
                                                                                                                                    </form>
                                                                                                                                </li>
                                                                                                                            <% }); %>
                                                                                                                        <% } %>
                                                                                                                    </ul>
                                                                                                                </fieldset>

                                                                                                                <br>
                                                                                                                <fieldset>
                                                                                                                    <legend>
                                                                                                                        6.
                                                                                                                        System
                                                                                                                        Maintenance
                                                                                                                    </legend>
                                                                                                                    <p>Download
                                                                                                                        a
                                                                                                                        backup
                                                                                                                        of
                                                                                                                        your
                                                                                                                        entire
                                                                                                                        system
                                                                                                                        data
                                                                                                                        (JSON
                                                                                                                        format).
                                                                                                                    </p>
                                                                                                                    <a href="/settings/backup"
                                                                                                                        target="_blank"><button
                                                                                                                            type="button">Download
                                                                                                                            Database
                                                                                                                            Backup</button></a>
                                                                                                                    <hr>
                                                                                                                    <p><small>Terminal
                                                                                                                            Version:
                                                                                                                            1.0.4-SECURE</small>
                                                                                                                    </p>
                                                                                                                </fieldset>
                                                                                                                <% } %>
            </main>

            <footer class="main-footer">
                <p>User Authenticated: <%= locals.username %> | System Status: ONLINE</p>
            </footer>
        </div> <!-- content-wrapper -->
    <script>
        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            sidebar.classList.toggle('open');
        }

        function editDue() {
            const total = parseFloat(document.getElementById('edit-total').value) || 0;
            const received = parseFloat(document.getElementById('edit-received').value) || 0;
            document.getElementById('edit-due').value = (total - received).toFixed(2);
        }
    </script>
</body>

</html>